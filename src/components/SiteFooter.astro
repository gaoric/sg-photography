---
import { fallbackSiteSettings } from "../lib/cms/fallback";
import type { SiteSettings } from "../lib/cms/types";

interface Props {
  animated?: boolean;
  settings?: SiteSettings;
}

const { animated = false, settings = fallbackSiteSettings } = Astro.props;
const footerClass = animated ? "site-footer" : "site-footer site-footer--static";
const currentYear = new Date().getFullYear();
---

<footer class={footerClass} data-footer={animated ? true : undefined}>
  <div class="footer-reveal" data-footer-reveal={animated ? true : undefined}>
    <div class="footer-content" data-footer-content={animated ? true : undefined}>
      <p class="footer-kicker">{settings.footer.kicker}</p>
      <p class="footer-quote">{settings.footer.quotePrefix} <em>{settings.footer.quoteEmphasis}</em>.</p>
      <nav class="footer-links" aria-label="Footer">
        {settings.navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <div class="footer-contact">
        <a href={`mailto:${settings.footer.email}`}>{settings.footer.email}</a>
        <a href={settings.footer.instagramUrl}>{settings.footer.instagramHandle}</a>
      </div>
      <p class="footer-copyright">
        &copy; {currentYear} {settings.businessName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{
  animated && (
    <script>
      import "../scripts/footer-motion";
    </script>
  )
}
