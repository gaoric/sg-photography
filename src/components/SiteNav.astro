---
import logo from "../assets/sg-logo.png";
import { fallbackSiteSettings } from "../lib/cms/fallback";
import type { SiteSettings } from "../lib/cms/types";

interface Props {
  settings?: SiteSettings;
}

const { settings = fallbackSiteSettings } = Astro.props;
---

<header class="site-header" aria-label="Primary navigation">
  <a class="logo-link" href="/" aria-label={`${settings.businessName} home`}>
    <img src={logo.src} width={logo.width} height={logo.height} alt={settings.businessName} />
  </a>

  <nav class="nav-links" aria-label="Main">
    {
      settings.navLinks.map((link) => (
        <a href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
