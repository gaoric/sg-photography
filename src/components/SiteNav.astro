---
import logo from "../assets/sg-logo.png";

const links = [
  { href: "/about/", label: "About" },
  { href: "/client-gallery/", label: "Client Gallery" },
  { href: "/contact/", label: "Contact" }
];
---

<header class="site-header" aria-label="Primary navigation">
  <a class="logo-link" href="/" aria-label="Sally Gao Photography home">
    <img src={logo.src} width={logo.width} height={logo.height} alt="Sally Gao Photography" />
  </a>

  <nav class="nav-links" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
