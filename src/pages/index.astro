---
import SanityImage from "../components/SanityImage.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomePage, getSiteSettings } from "../lib/cms/sanity-content";

const [homePage, siteSettings] = await Promise.all([getHomePage(), getSiteSettings()]);
const portfolioItems = homePage.portfolioItems;
const testimonials = homePage.testimonials;
const services = homePage.services;
---

<BaseLayout title={homePage.seo.title} description={homePage.seo.description}>
  <SiteNav settings={siteSettings} />

  <main>
    <section class="hero-scroll" data-hero-scroll aria-label="Homepage hero image and introduction">
      <div class="hero-sticky" data-hero-stage>
        <section class="intro" data-hero-copy aria-labelledby="homepage-title">
          <p class="intro-kicker" data-hero-copy-top>{homePage.hero.kicker}</p>
          <h1 id="homepage-title" class="intro-heading">
            <span class="intro-heading__line intro-heading__line--top" data-hero-title-top>
              {homePage.hero.headingTop}
            </span>
            <span class="intro-heading__line intro-heading__line--bottom" data-hero-title-bottom>
              {homePage.hero.headingBottom}
            </span>
          </h1>
          <p class="intro-subtitle" data-hero-copy-bottom>{homePage.hero.subtitle}</p>
        </section>

        <div class="hero-frame" data-hero-frame>
          <SanityImage
            image={homePage.hero.image}
            widths={[640, 960, 1280, 1600, 2200]}
            sizes="100vw"
            loading="eager"
          />
        </div>
        <section class="introduction" id="introduction" data-introduction aria-label="Introduction">
          <p
            class="introduction-copy introduction-copy--base"
            data-introduction-copy
            aria-label={homePage.introduction.ariaLabel}
          >
            <span class="introduction-copy__slots" aria-hidden="true">
              {
                homePage.introduction.firstState.map((word, index) => (
                  <span class="introduction-copy__slot" data-intro-word-slot>
                    <span class="introduction-copy__track" data-intro-word-track>
                      <span class="introduction-copy__word">{word}</span>
                      <span class={`introduction-copy__word${index === 2 ? " introduction-copy__word--italic" : ""}`}>
                        {homePage.introduction.secondState[index]}
                      </span>
                    </span>
                  </span>
                ))
              }
            </span>
          </p>
        </section>
      </div>
    </section>

    <section class="photographer-intro" aria-label="Photographer introduction">
      <p class="photographer-intro__text photographer-intro__text--left">
        {homePage.photographerIntro.leftText}
      </p>
      <div class="photographer-intro__portrait">
        <SanityImage
          image={homePage.photographerIntro.image}
          widths={[320, 480, 640, 840]}
          sizes="(max-width: 560px) 72vw, 30vw"
          loading="lazy"
        />
      </div>
      <p class="photographer-intro__text photographer-intro__text--right">
        {homePage.photographerIntro.rightText}
      </p>
    </section>

    <section class="portfolio-showcase" aria-label="Selected portfolio photographs">
      {
        portfolioItems.map((item, index) => (
          <figure class={`portfolio-tile portfolio-tile--${index + 1}`} tabindex="0">
            <SanityImage
              image={item.image}
              widths={[360, 540, 720, 960]}
              sizes="(max-width: 560px) 50vw, 33.333vw"
              loading="lazy"
            />
            <figcaption class="portfolio-tile__caption">
              <span class="portfolio-tile__names">{item.names}</span>
              <span class="portfolio-tile__place">{item.place}</span>
            </figcaption>
          </figure>
        ))
      }
    </section>

    <section class="testimonials" aria-labelledby="testimonials-title">
      <h2 class="testimonials__title" id="testimonials-title">{homePage.testimonialsTitle}</h2>
      <div class="testimonial-row">
        {
          testimonials.map((testimonial, index) => (
            <button
              class="testimonial-card"
              type="button"
              data-testimonial-card
              aria-label={`Show testimonial from ${testimonial.name}`}
              style={`--card-rotate: ${[-7, 5, -3, 7][index] ?? 0}deg; --card-offset-y: ${[0, 18, 8, 22][index] ?? 0}px;`}
            >
              <span class="testimonial-card__inner" data-testimonial-inner>
                <span class="testimonial-card__face testimonial-card__face--front">
                  <span class="testimonial-card__image">
                    <SanityImage
                      image={testimonial.image}
                      widths={[260, 380, 520, 680]}
                      sizes="(max-width: 560px) 72vw, (max-width: 960px) 42vw, 22vw"
                      loading="lazy"
                    />
                  </span>
                  <span class="testimonial-card__name">{testimonial.name}</span>
                </span>
                <span class="testimonial-card__face testimonial-card__face--back">
                  <span class="testimonial-card__quote">&ldquo;{testimonial.quote}&rdquo;</span>
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="services" aria-label="Services offered">
      <div class="services__copy-track">
        {
          services.map((service) => (
            <article class="service-copy" data-service-copy>
              <div class="service-copy__mobile-media">
                <SanityImage
                  image={service.image}
                  widths={[480, 720, 960, 1200]}
                  sizes="100vw"
                  loading="lazy"
                />
              </div>
              <div class="service-copy__body">
                <h2>{service.title}</h2>
                <p>{service.description}</p>
                <p class="service-copy__price">{service.price}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="services__media-track">
        {
          services.map((service) => (
            <figure class="service-media" data-service-media>
              <SanityImage
                image={service.image}
                widths={[480, 720, 960, 1200, 1440]}
                sizes="(max-width: 700px) 100vw, 44vw"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter settings={siteSettings} animated />

  <script>
    import "../scripts/homepage-motion";
    import "../scripts/services-snap";
    import "../scripts/testimonials";
  </script>
</BaseLayout>
