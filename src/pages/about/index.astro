---
import SanityImage from "../../components/SanityImage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAboutPage, getSiteSettings } from "../../lib/cms/sanity-content";

const [aboutPage, siteSettings] = await Promise.all([getAboutPage(), getSiteSettings()]);
---

<BaseLayout title={aboutPage.seo.title} description={aboutPage.seo.description}>
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("about-motion-enabled");
    }
  </script>

  <SiteNav settings={siteSettings} />

  <main class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero__portrait">
        <SanityImage
          image={aboutPage.portrait}
          widths={[420, 620, 840, 1080]}
          sizes="(max-width: 780px) 84vw, 34vw"
          loading="eager"
        />
      </div>

      <div class="about-hero__content">
        <h1 id="about-title">
          <span data-about-heading-line>{aboutPage.headingLines[0]}</span>
          <span data-about-heading-line>{aboutPage.headingLines[1]}</span>
        </h1>

        <p data-about-body>{aboutPage.intro}</p>

        <h2 data-about-heading-line>{aboutPage.approachHeading}</h2>

        <p data-about-body>{aboutPage.approach}</p>
      </div>
    </section>
  </main>

  <SiteFooter settings={siteSettings} animated />

  <script>
    import "../../scripts/about-motion";
  </script>
</BaseLayout>
